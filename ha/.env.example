# ----------------------------------------------------------------
# Homebridge HA Pair – Environment Variables
# Copy this file to ".env" and fill in the values for each node.
# ----------------------------------------------------------------

# Role of THIS node: "primary" or "secondary"
HA_NODE_ROLE=primary

# IP address or hostname of the PEER node
HA_PEER_IP=192.168.1.2

# Homebridge UI port used for health checks (default: 8581)
HA_PEER_PORT=8581

# Seconds between health-check polls (default: 30)
HA_CHECK_INTERVAL=30

# Total seconds the primary must be unreachable before failover fires (default: 90)
HA_FAILOVER_TIMEOUT=90

# Seconds between config-sync runs (default: 300 = every 5 minutes)
HA_SYNC_INTERVAL=300

# SSH username on the PEER host used for rsync (default: root)
HA_SYNC_USER=root

# Absolute path to the homebridge volume on the PEER HOST (default: /homebridge)
# This is the HOST-side mount path (e.g. /home/user/homebridge-ha/volumes/homebridge)
HA_SYNC_PATH=/homebridge

# Path to the SSH private key file on THIS host (mounted into the companion container)
HA_SSH_KEY_PATH=./ha-ssh-key

# Timezone (see https://en.wikipedia.org/wiki/List_of_tz_database_time_zones)
TZ=UTC
