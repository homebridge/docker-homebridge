#!/command/with-contenv sh

. /etc/s6-overlay/scripts/safe-path.sh
. /etc/s6-overlay/scripts/service-user.sh

export HOME=/home/homebridge
export USER=root
export HOMEBRIDGE_CONFIG_UI=1

# This is not the version of the UI. The Homebridge UI still reads it as a
# feature switch: a value from 4.6.2 to 4.44.1 turns on its old "offline
# update" mode for Docker. 4.44.2 keeps that mode off. Do not remove it.
export CONFIG_UI_VERSION=4.44.2

# returns non-zero if the UI is configured to listen on a privileged port and
# the homebridge user can not be given the right to use one. Homebridge then
# has to run as root.
ui_port_check() {
  [ -f /var/lib/homebridge/config.json ] || return 0

  ui_port=$(jq -rM '.platforms[]? | select(.platform == "config") | .port' /var/lib/homebridge/config.json 2> /dev/null) || return 0

  # no port configured, or not a number
  case "$ui_port" in
    '' | *[!0-9]*) return 0 ;;
  esac

  if [ "$ui_port" -lt 1024 ]; then
    case "$HB_CAPABILITIES" in
      *net_bind_service*) return 0 ;;
    esac
    echo "The Homebridge UI has been configured to run on a privileged port ($ui_port); the Homebridge service will run as root."
    return 1
  fi
}

# s6 starts this service as soon as the avahi service has been started, which
# can be a moment before avahi-daemon is ready. Give it up to 10 seconds, so
# Homebridge does not ask avahi too early on a slow machine.
if [ "$ENABLE_AVAHI" = "1" ]; then
  hb_avahi_waited=0
  until [ -S /var/run/avahi-daemon/socket ] || [ "$hb_avahi_waited" -ge 10 ]; do
    sleep 1
    hb_avahi_waited=$((hb_avahi_waited + 1))
  done
fi

# start.sh from the apt package deletes every plugin when package.json is not
# valid JSON, so repair the file first. This runs again each time Homebridge
# is restarted.
. /etc/s6-overlay/scripts/package-json.sh
hb_package_json_repair /homebridge
hb_package_json_backup /homebridge

if hb_resolve_service_user; then
  HB_CAPABILITIES=$(hb_network_capabilities)

  # the ownership is re-applied here, after the setup and userdata scripts have
  # run, because both of them write to these paths as root
  if ! hb_fix_permissions /homebridge /opt/homebridge /home/homebridge; then
    echo "Failed to set ownership of /homebridge to ${HB_SERVICE_UID}:${HB_SERVICE_GID}; the Homebridge service will run as root."
  elif ui_port_check; then
    export USER=homebridge
    # setpriv changes to the homebridge user and hands over the network rights.
    # It is tried with a harmless command first.
    if [ -n "$HB_CAPABILITIES" ] && setpriv --reuid "$HB_SERVICE_UID" --regid "$HB_SERVICE_GID" --init-groups \
      --inh-caps "$HB_CAPABILITIES" --ambient-caps "$HB_CAPABILITIES" true 2> /dev/null; then
      echo "Starting Homebridge as the homebridge user (uid ${HB_SERVICE_UID}, gid ${HB_SERVICE_GID}) with the network rights ${HB_CAPABILITIES}"
      exec setpriv --reuid "$HB_SERVICE_UID" --regid "$HB_SERVICE_GID" --init-groups \
        --inh-caps "$HB_CAPABILITIES" --ambient-caps "$HB_CAPABILITIES" /opt/homebridge/start.sh
    fi
    echo "Starting Homebridge as the homebridge user (uid ${HB_SERVICE_UID}, gid ${HB_SERVICE_GID})"
    echo "NOTE: no network rights could be handed to the homebridge user. Plugins that use a port below 1024 or raw network packets (ping) will not work in this mode."
    exec /command/s6-setuidgid homebridge /opt/homebridge/start.sh
  fi
fi

# start homebridge
exec /opt/homebridge/start.sh --allow-root
